# Dependencies
node_modules/

# Environment / secrets
.env
.env.local
.env.production

# Build output
dist/

# Logs
*.log

# Database dumps
*.sql
!backend/migrations/*.sql

# Shell scripts (deploy, db ops — personal config)
*.sh

# Nginx (use nginx.conf.example as template)
nginx.conf

# Docker compose local-dev overrides
docker-compose.override.yml

# Archives
*.tar.gz

# Uploads (user-generated content)
backend/uploads/*
!backend/uploads/.gitkeep

# Built frontend served by backend
backend/public/

# Scraped content
scraped-*.html

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude config (personal)
.claude/

# Per-instance deployment config and artwork. This repo is public: the real
# files name the server, the domains and the orchestras, so only the *example*
# templates are tracked. (deploy-new.sh, deploy/migrate-to-edge-proxy.sh and
# deploy/baseline.sql are already covered by the *.sh and *.sql rules above.)
deploy/instances/*.env
!deploy/instances/example.env
deploy/proxy/conf.d/*.conf
!deploy/proxy/conf.d/*.example.conf
branding/*/
!branding/example/
