# Template for a deployment target. Copy to <name>.env and fill in.
# Real instance files are gitignored — this repo is public, and <name>.env
# names the server you deploy to.
#
#   cp deploy/instances/example.env deploy/instances/myorchestra.env
#   ./deploy-new.sh myorchestra
#
# Non-secret only — DB credentials are read from .env on the server.

SSH_USER=ubuntu
SSH_HOST=your-server.example.com
REMOTE_PATH=/home/ubuntu/orchestra

# Container name prefix: <STACK>-app, <STACK>-mysql. Must match the STACK set in
# the server's .env, and must be unique per instance on the VM.
STACK=orchestra

DOMAIN=example.com

# branding/<BRANDING>/ supplies logo.<ext>, logo-dark.<ext> and favicon.ico
BRANDING=example
ORG_NAME="Your Orchestra"
ORG_LEGAL_NAME="Your Orchestra Association"

# true when the logo already spells the name, which suppresses the text beside
# it. false for a compact mark that needs the name next to it.
LOGO_WORDMARK=false

# 'svg' (default) or 'png' — whichever the brand's artwork uses.
LOGO_EXT=svg
